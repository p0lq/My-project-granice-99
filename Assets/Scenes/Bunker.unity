  objectiveItem: 3
  objectiveBefore: "\u041D\u0430\u0439\u0434\u0438 \u0430\u043D\u0442\u0438\u0434\u043E\u0442 \xAB\u041F\u0424-2\xBB \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438. \u0413\u0435\u0440\u043C\u043E\u0434\u0432\u0435\u0440\u0438 \u043D\u0443\u0436\u043D\u043E \u043F\u0438\u0442\u0430\u043D\u0438\u0435"
