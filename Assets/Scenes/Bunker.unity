  m_Script: {fileID: 11500000, guid: ac4220503906c7c44870fdea078c101b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameMenus
  winTitle: "\u0410\u043D\u0442\u0438\u0434\u043E\u0442 \u0443 \u0442\u0435\u0431\u044F"
  winText: "\u0422\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F \u0438\u0437 \xAB\u041F\u043E\u0434\u0437\u0435\u043C\u043A\u0438\xBB \u0441 \u0430\u043C\u043F\u0443\u043B\u0430\u043C\u0438 \xAB\u041F\u0424-2\xBB. \u0421\u0430\u0440\u044B\u043A\u0443\u0434\u0443\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u0448\u0430\u043D\u0441."
  loseTitle: "\u0422\u044B \u043F\u043E\u0433\u0438\u0431"
  loseText: "\u0421\u0442\u0435\u043F\u044C \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u0435\u0442 \u043E\u0448\u0438\u0431\u043E\u043A. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437: \xAB\u0421\u0435\u0440\u044B\u0435\xBB \u0441\u043B\u044B\u0448\u0430\u0442 \u0431\u0435\u0433 \u0438 \u0432\u0438\u0434\u044F\u0442 \u0441\u0432\u0435\u0442."
